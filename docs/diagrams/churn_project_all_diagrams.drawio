<mxfile host="app.diagrams.net" type="device"><diagram name="ETL Pipeline Flow" id="etl-pipeline-flow"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="860" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="ETL Pipeline Flow – Customer Churn Project" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Raw data → Extract → Transform → Validate → Load (Parquet). Update step names and columns after Practical C3." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c4" value="1. Sources" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=center;fontStyle=1;fontSize=14;spacingTop=6;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="220" height="450" as="geometry"/></mxCell><mxCell id="c5" value="2. Extract (E)&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;src/etl/extract.py&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=center;fontStyle=1;fontSize=14;spacingTop=6;container=0;" vertex="1" parent="1"><mxGeometry x="300" y="80" width="240" height="450" as="geometry"/></mxCell><mxCell id="c6" value="3. Transform (T)&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;src/etl/transform.py&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=center;fontStyle=1;fontSize=14;spacingTop=6;container=0;" vertex="1" parent="1"><mxGeometry x="580" y="80" width="260" height="450" as="geometry"/></mxCell><mxCell id="c7" value="4. Validate&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;src/etl/validate.py&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;align=center;fontStyle=1;fontSize=14;spacingTop=6;container=0;" vertex="1" parent="1"><mxGeometry x="880" y="80" width="260" height="450" as="geometry"/></mxCell><mxCell id="c8" value="5. Load (L)&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;src/etl/load.py&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=center;fontStyle=1;fontSize=14;spacingTop=6;container=0;" vertex="1" parent="1"><mxGeometry x="1180" y="80" width="260" height="450" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Data files&lt;/b&gt;&lt;br&gt;CSV / JSON / Excel" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.15;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="150" width="160" height="70" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;SQLite database&lt;/b&gt;&lt;br&gt;(.db file)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="260" width="140" height="90" as="geometry"/></mxCell><mxCell id="c11" value="Stored in &lt;b&gt;data/raw/&lt;/b&gt;&lt;br&gt;never edited by hand" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="55" y="380" width="190" height="40" as="geometry"/></mxCell><mxCell id="c12" value="Read each file with pandas&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;read_csv / read_json / read_excel&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="158" width="200" height="54" as="geometry"/></mxCell><mxCell id="c13" value="Query tables with sqlite3&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;read-only connection&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="278" width="200" height="54" as="geometry"/></mxCell><mxCell id="c14" value="Log rows and columns&lt;br&gt;per source" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="375" width="200" height="44" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Raw DataFrames&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="455" width="200" height="40" as="geometry"/></mxCell><mxCell id="c16" value="1. Standardise column names" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="132" width="220" height="36" as="geometry"/></mxCell><mxCell id="c17" value="2. Fix data types" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="180" width="220" height="36" as="geometry"/></mxCell><mxCell id="c18" value="3. Remove duplicates" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="228" width="220" height="36" as="geometry"/></mxCell><mxCell id="c19" value="4. Handle missing values" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="276" width="220" height="36" as="geometry"/></mxCell><mxCell id="c20" value="5. Clean categories / typos" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="324" width="220" height="36" as="geometry"/></mxCell><mxCell id="c21" value="6. Handle impossible values" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="372" width="220" height="36" as="geometry"/></mxCell><mxCell id="c22" value="7. Join sources on customer key" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="420" width="220" height="36" as="geometry"/></mxCell><mxCell id="c23" value="8. Create churn label (0 / 1)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="468" width="220" height="36" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Data quality checks&lt;/b&gt;&lt;br&gt;• No duplicate customer IDs&lt;br&gt;• No nulls in required columns&lt;br&gt;• Values in valid ranges&lt;br&gt;• churn is only 0 or 1&lt;br&gt;• Row counts logged" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="900" y="130" width="220" height="140" as="geometry"/></mxCell><mxCell id="c25" value="All checks&lt;br&gt;pass?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="945" y="310" width="130" height="90" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Stop the pipeline&lt;/b&gt;&lt;br&gt;log error + failing rows&lt;br&gt;nothing is written" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="910" y="440" width="200" height="66" as="geometry"/></mxCell><mxCell id="c27" value="Write Parquet with pyarrow&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;replace the file, never append&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="130" width="220" height="54" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;output/cleaned/&lt;/b&gt;&lt;br&gt;churn_dataset.parquet" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1230" y="225" width="160" height="100" as="geometry"/></mxCell><mxCell id="c29" value="Log run summary&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;rows in / out, rows dropped, time&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="365" width="220" height="54" as="geometry"/></mxCell><mxCell id="e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="c9" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="c10" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;end